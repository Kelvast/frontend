# ─── Server ───────────────────────────────────────────────────────────────────

# WebSocket server URL (used by the browser to connect to the game server)
NEXT_PUBLIC_MMO_SERVER_URL=ws://localhost:8080

# Base URL for the upstream Lambda API (server-only — never exposed to the browser)
API_URL=


# ─── Dev mode ─────────────────────────────────────────────────────────────────

# Set to "true" to enable dev mode (auto-login, auto-register on auth fail)
NEXT_PUBLIC_DEV_MODE=false

# Dev credentials used for auto-login when NEXT_PUBLIC_DEV_MODE=true
NEXT_PUBLIC_DEV_EMAIL=
NEXT_PUBLIC_DEV_PASSWORD=
